{
  "hosting": {
    "target": "game",
    "public": "dist/mobile",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "**/*.@(html|js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(png|jpg|svg|woff2|mp3)", "headers": [{ "key": "Cache-Control", "value": "max-age=604800" }] }
    ]
  }
}
